// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// User Roles
enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

// User Model (NextAuth compatible)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?   // For credentials authentication
  image         String?
  phone         String?   @unique
  role          UserRole  @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  onboardingCompleted Boolean   @default(false)
  clientInterests     String[]
  
  // Settings preferences (stored as JSON)
  notificationPreferences Json? @default("{\"emailJobAlerts\":true,\"emailMessages\":true,\"emailBookings\":true,\"emailReviews\":true,\"emailMarketing\":false,\"pushNotifications\":true}")
  privacySettings         Json? @default("{\"profileVisible\":true,\"searchable\":true,\"showLocation\":true,\"allowMessages\":true}")
  
  // Account deletion tracking
  deletionScheduledAt DateTime?
  deletionReason      String?

  accounts      Account[]
  sessions      Session[]
  
  // Relations
  profile       Profile?
  services      Service[]
  jobs          Job[]
  proposals     Proposal[]
  bookings      Booking[]     @relation("ClientBookings")
  providerBookings Booking[]  @relation("ProviderBookings")
  reviews       Review[]      @relation("WrittenReviews")
  receivedReviews Review[]    @relation("ReceivedReviews")
  sentMessages  Message[]     @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
  notifications Notification[]
  wallet        Wallet?
  subscription  Subscription?
  disputes      Dispute[]     @relation("CreatedDisputes")
  disputesAgainst Dispute[]   @relation("DisputesAgainst")
  supportTickets SupportTicket[]
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Provider Profile
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?  @db.Text
  skills      String[]
  hourlyRate  Decimal? @db.Decimal(10, 2)
  portfolio   String[] // URLs to images/videos
  isVerified  Boolean  @default(false)
  verificationStatus String? @default("PENDING") // PENDING, VERIFIED, REJECTED
  idDocument  String?  // URL to ID document
  location    String?
  latitude    Float?
  longitude   Float?
  certifications Json? @default("[]") // Array of {name, issuer, date, fileUrl}
  education   Json? @default("[]") // Array of {institution, degree, field, startYear, endYear}
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Service Categories
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  image       String?
  description String?
  parentId    String?
  
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  services    Service[]
  jobs        Job[]
}

// Services offered by Providers
model Service {
  id          String   @id @default(cuid())
  providerId  String
  categoryId  String
  title       String
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  pricingUnit String   // e.g., "per hour", "fixed"
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id])
  bookings    Booking[]
}

// Jobs posted by Clients
enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Job {
  id          String    @id @default(cuid())
  clientId    String
  categoryId  String
  title       String
  description String    @db.Text
  budget      Decimal?  @db.Decimal(10, 2)
  location    String?
  deadline    DateTime?
  status      JobStatus @default(OPEN)
  images      String[]  // URLs to job images/photos
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client      User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id])
  proposals   Proposal[]
  bookings    Booking[]
}

// Proposals/Bids on Jobs
enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Proposal {
  id          String         @id @default(cuid())
  jobId       String
  providerId  String
  coverLetter String         @db.Text
  price       Decimal        @db.Decimal(10, 2)
  status      ProposalStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider    User           @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// Bookings
enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

model Booking {
  id          String        @id @default(cuid())
  clientId    String
  providerId  String
  serviceId   String?
  jobId       String?
  date        DateTime
  status      BookingStatus @default(PENDING)
  totalAmount Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client      User      @relation("ClientBookings", fields: [clientId], references: [id])
  provider    User      @relation("ProviderBookings", fields: [providerId], references: [id])
  service     Service?  @relation(fields: [serviceId], references: [id])
  job         Job?      @relation(fields: [jobId], references: [id])
  payment     Payment?
  review      Review?
  dispute     Dispute?
}

// Reviews
model Review {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  authorId    String
  targetId    String
  rating      Int      @default(5)
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author      User     @relation("WrittenReviews", fields: [authorId], references: [id])
  target      User     @relation("ReceivedReviews", fields: [targetId], references: [id])
}

// Payments
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MPESA
  CARD
  PAYPAL
  WALLET
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       // External transaction ID (e.g., M-Pesa code)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id])
}

// Wallet
model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balance     Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  EARNING
}

model Transaction {
  id          String          @id @default(cuid())
  walletId    String
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())

  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

// Messages
model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

// Notifications
model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String   // e.g., "JOB_ALERT", "PAYMENT", "SYSTEM"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Subscriptions
enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

model Subscription {
  id          String           @id @default(cuid())
  userId      String           @unique
  plan        SubscriptionPlan @default(FREE)
  startDate   DateTime         @default(now())
  endDate     DateTime?
  isActive    Boolean          @default(true)

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Disputes
enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED
}

model Dispute {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  creatorId   String
  defendantId String
  reason      String        @db.Text
  status      DisputeStatus @default(OPEN)
  resolution  String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking     Booking       @relation(fields: [bookingId], references: [id])
  creator     User          @relation("CreatedDisputes", fields: [creatorId], references: [id])
  defendant   User          @relation("DisputesAgainst", fields: [defendantId], references: [id])
}

// Support Tickets
model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject     String
  description String   @db.Text
  category    String   // Account, Payments, Technical, Bookings, General
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  
  adminNotes  String?  @db.Text
  resolution  String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  
  @@index([userId])
  @@index([status])
}
